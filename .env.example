# Chassix AI — environment template. Copy to .env and fill in. NEVER commit .env.
# Secrets are read server-side only and are never printed or sent to the client.

# --- LLM / intelligence (ADR-D9) ---
ANTHROPIC_API_KEY=

# --- Literature / dataset discovery (ADR-D9, Apify) ---
APIFY_TOKEN=

# --- Database (ADR-D5, Postgres) ---
DATABASE_URL=postgresql://chassix:chassix@localhost:5432/chassix

# --- Object storage (ADR-D6, S3-compatible / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chassix-artifacts
S3_ACCESS_KEY_ID=chassix
S3_SECRET_ACCESS_KEY=chassix-dev-secret

# --- API ---
API_PORT=3001
JWT_SECRET=
WEB_ORIGIN=http://localhost:5173
