# Chassix AI — environment template. Copy to .env and fill in. NEVER commit .env.
# Secrets are read server-side only and are never printed or sent to the client.

# --- LLM / intelligence (ADR-D9) ---
ANTHROPIC_API_KEY=

# --- Literature / dataset discovery (ADR-D9, Apify) ---
APIFY_API_TOKEN=

# --- Planner / LLM (ADR-D9) ---
# Defaults to claude-opus-4-8 (medium effort) when unset.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Database (ADR-D5, Postgres) ---
DATABASE_URL=postgresql://chassix:chassix@localhost:5432/chassix

# --- API ---
API_PORT=3001
JWT_SECRET=
WEB_ORIGIN=http://localhost:5173

# --- Live run-event layer (ADR-D8, SpaceTimeDB sponsor integration) ---
# See docs/spacetimedb-setup.md. Leave blank to use the in-memory/SSE transport.
SPACETIME_URI=
SPACETIME_MODULE=
SPACETIME_TOKEN=

# --- Google Cloud: workflow execution (ADR-D4) + object storage (ADR-D6) ---
# Server-side only. See workflows/README.md and docs/handoffs/owner-setup-tasks.md for how to
# fetch each value from the gcloud CLI. (We use Google Cloud Storage, not S3/MinIO.)
GCP_PROJECT_ID=
GCP_REGION=us-central1
# One GCS bucket for uploaded datasets, run artifacts, and per-study workflow inputs/outputs.
GCS_BUCKET=
# Absolute path to a service-account key JSON (Batch + Storage + Artifact Registry access).
GOOGLE_APPLICATION_CREDENTIALS=
# Optional — only if you point an S3-compatible client at GCS instead of the native SDK
# (GCS interoperability / HMAC keys). Most setups can leave these blank.
# GCS_HMAC_ACCESS_KEY=
# GCS_HMAC_SECRET=

# --- Nextflow executor (ADR-D4, optional alternative to direct GCP Batch) ---
NEXTFLOW_ENDPOINT=
NEXTFLOW_TOKEN=
