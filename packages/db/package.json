{
  "name": "@chassix/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "node -r ./drizzle-js-resolve.cjs ./node_modules/drizzle-kit/bin.cjs generate",
