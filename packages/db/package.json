    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chassix/shared": "workspace:*",
    "drizzle-orm": "0.36.4",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.28.1"
  }
}
