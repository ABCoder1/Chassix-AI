{
  "name": "bioforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:stack": "docker compose up -d",
    "dev:stack:down": "docker compose down",
    "dev:stack:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/node": "20.16.11",
    "eslint": "9.13.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.3"
  }
}
